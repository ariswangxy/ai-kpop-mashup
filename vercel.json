{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "separator", "format": "url", "env": "SEPARATOR_URL" }
      ]
    },
    "separator": {
      "root": "separator",
      "runtime": "python",
      "entrypoint": "server:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
